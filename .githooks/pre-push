#!/bin/sh
# Runs the same checks as CI, before anything leaves the machine.
# Total ~7s. Skip with: git push --no-verify
#
# The checks themselves live in bin/preflight, which bin/deploy also runs — one
# definition, so a check can never be in the push gate but missing from a
# deploy, or the other way round.
set -e

cd "$(git rev-parse --show-toplevel)"
exec bin/preflight
