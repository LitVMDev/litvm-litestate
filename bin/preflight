#!/bin/sh
# Every check that must pass before code leaves this machine or a contract goes
# on-chain. This is the single definition of "green": .githooks/pre-push and
# bin/deploy both call it, so a check added here is one they both get.
#
#   bin/preflight            all checks
#   bin/preflight --quick    contracts only, skip the web build
#   bin/preflight --deploy   also refuse a dirty tree (deployed bytecode should
#                            correspond to a commit you can point at)
#
# FINISHED A FEATURE? The whole sequence, either way:
#
#   Website only                 Contracts (with or without website)
#   ------------                 -----------------------------------
#   bin/preflight                bin/preflight        # rewrites ABIs if stale;
#   git commit -am "..."                              # fails once so you can
#   git push                                          # review them
#                                git commit -am "..."
#   Pushing publishes the site.  git push
#                                bin/deploy --broadcast          # new factory
#                                # then: KNOWN_FACTORIES + GitHub variable,
#                                # commit those, push again to publish the site
#
# Existing estates keep running the OLD contract code forever - a contract fix
# only reaches estates created after the new factory is live. See DEV.md.
#
# Failing output is shown, not swallowed - the whole point is not having to
# re-run the command by hand to find out what broke.
set -e

cd "$(git rev-parse --show-toplevel)"

QUICK=0
DEPLOY=0

for arg in "$@"; do
  case "$arg" in
    --quick) QUICK=1 ;;
    --deploy) DEPLOY=1 ;;
    -h | --help)
      awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
      exit 0
      ;;
    *)
      printf 'unknown option: %s (try --help)\n' "$arg" >&2
      exit 2
      ;;
  esac
done

bold=$(printf '\033[1m')
red=$(printf '\033[31m')
green=$(printf '\033[32m')
yellow=$(printf '\033[33m')
off=$(printf '\033[0m')

pass() { printf '%s  ok%s   %s\n' "$green" "$off" "$1"; }
skip() { printf '%s  skip%s %s\n' "$yellow" "$off" "$1"; }
warn() { printf '%s  warn%s %s\n' "$yellow" "$off" "$1"; }

fail() {
  printf '%s  FAIL%s %s\n' "$red" "$off" "$1"
  if [ -n "$2" ] && [ -s "$2" ]; then
    printf '\n%s--- output ---%s\n' "$bold" "$off"
    tail -n 40 "$2"
    printf '%s--------------%s\n\n' "$bold" "$off"
  fi
  [ -n "$3" ] && printf 'fix: %s\n' "$3"
  exit 1
}

# run <label> <fix-hint> <command…>
run() {
  label=$1
  hint=$2
  shift 2

  log=$(mktemp)
  if "$@" >"$log" 2>&1; then
    pass "$label"
    rm -f "$log"
  else
    fail "$label" "$log" "$hint"
  fi
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    printf '%s  FAIL%s %s is not installed\n' "$red" "$off" "$1"
    exit 1
  }
}

printf '%spreflight%s\n' "$bold" "$off"

need forge
need node

# --- source of truth ---------------------------------------------------------

if [ -n "$(git status --porcelain)" ]; then
  if [ "$DEPLOY" = 1 ]; then
    printf '%s  FAIL%s uncommitted changes\n' "$red" "$off"
    git status --short
    printf '\nCommit or stash first: what goes on-chain should match a commit.\n'
    printf 'Override with: bin/deploy --allow-dirty\n'
    exit 1
  fi
  warn "working tree is dirty (fine for a push, not for a deploy)"
else
  pass "clean tree ($(git rev-parse --short HEAD))"
fi

# --- contracts ---------------------------------------------------------------

run "format" "forge fmt" forge fmt --check

# forge test does NOT catch an oversized contract; only --sizes does, and
# EstateFactory embeds two contracts' bytecode, so it lives near the limit.
run "contract sizes (EIP-170)" "shrink the contract or raise optimizer_runs" \
  forge build --sizes

run "contract tests" "forge test -vv" forge test

# --- ABIs --------------------------------------------------------------------

# A stale ABI is invisible until the UI calls a function that no longer exists,
# which on a deployed front end means a user hitting it, not you.
#
# Staleness is "regenerating would change something", which is not the same as
# "differs from HEAD" — checking the latter (as this once did) fails on every
# run where the ABI is correct but simply not committed yet. So snapshot, regen,
# compare against the snapshot.
snapshot=$(mktemp -d)
cp web/src/abis/*.ts "$snapshot/"

log=$(mktemp)
if node web/scripts/generate-abis.mjs >"$log" 2>&1; then
  if diff -q "$snapshot" web/src/abis >/dev/null 2>&1; then
    pass "ABIs current"
    rm -f "$log"
    rm -rf "$snapshot"
  else
    printf '%s  FAIL%s ABIs were stale — they have just been regenerated\n' "$red" "$off"
    diff -rq "$snapshot" web/src/abis 2>&1 | sed 's/^/    /'
    rm -rf "$snapshot"
    printf '\nThe contracts changed without web/src/abis being rebuilt. Review the\n'
    printf 'regenerated files and commit them with the contract change.\n'
    exit 1
  fi
else
  rm -rf "$snapshot"
  fail "ABI generation" "$log" "forge build && node web/scripts/generate-abis.mjs"
fi

# --- web ---------------------------------------------------------------------

if [ "$QUICK" = 1 ]; then
  skip "web (--quick)"
elif [ ! -d web/node_modules ]; then
  skip "web (node_modules missing — run: cd web && npm install)"
else
  run "typecheck" "cd web && npx tsc -b" sh -c "cd web && npx tsc -b"
  run "web build" "cd web && npm run build" sh -c "cd web && npm run build"
fi

printf '%sall checks passed%s\n' "$green" "$off"
