# Copy to .env.local (gitignored) and fill in.
# Vite inlines VITE_* vars at build time - there is no runtime server, so a
# rebuild is needed after changing them.

# Address of the deployed EstateFactory.
VITE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect / Reown project ID, from https://cloud.reown.com
#
# Only needed for mobile browsers, which cannot inject a wallet provider.
# Leave it blank and the WalletConnect option disappears; desktop still works
# through a browser extension.
#
# Not a secret: it is inlined into the published JavaScript and is visible to
# anyone. Restrict it by allowed domain in the Reown dashboard instead.
VITE_WC_PROJECT_ID=
