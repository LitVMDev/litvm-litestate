# Copy to .env and fill in. .env is gitignored - never commit real values.

# ------------------------------------------------------------
# Deployment
# ------------------------------------------------------------
# Prefer an encrypted keystore over a raw private key:
#
#   cast wallet import litvm-deployer --interactive
#   forge script script/DeployFactory.s.sol \
#     --rpc-url litvm_testnet --broadcast --account litvm-deployer
#
# That keeps the key encrypted on disk instead of in a plaintext env var
# or your shell history.

# Address of the deployed EstateFactory, needed by CreateEstate.s.sol
# and by the web UI (see web/.env.example).
FACTORY=

# ------------------------------------------------------------
# Per-estate settings used by script/CreateEstate.s.sol
# ------------------------------------------------------------
# All optional - defaults shown. These are one user's preferences, not
# platform policy; the platform limits live in Estate's constants.

# Days between required check-ins (platform range: 30 .. 1825)
HEARTBEAT_DAYS=180

# Days of grace after a missed check-in (platform range: 7 .. 365)
GRACE_DAYS=30

# 0 = Automatic, 1 = ApprovalRequired
APPROVAL_MODE=1

# 0 = AnyOne, 1 = All, 2 = Threshold
APPROVAL_RULE=0

# Only read when APPROVAL_RULE=2. Must be 1..5 (Estate.MAX_APPROVERS)
APPROVAL_THRESHOLD=0

# Days approvers have to act once grace expires (platform range: 7 .. 365)
APPROVAL_WINDOW_DAYS=30
